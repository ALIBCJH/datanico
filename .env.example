# SMTP credentials for the contact/quote email API route (src/app/api/send-email).
# Copy this file to `.env.local` and fill in real values. Without these set,
# the API route logs submissions to the server console instead of emailing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
# Where contact form submissions are delivered:
CONTACT_TO=info@datani.co.ke
